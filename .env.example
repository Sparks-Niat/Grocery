# =====================================================================
# SRI MANIKANTA SAI GENERAL STORE — PRODUCTION ENVIRONMENT VARIABLES
# =====================================================================

# ---------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard)
# ---------------------------------------------------------------------

# Neon PostgreSQL Database Connection String
# (From Neon Console > Dashboard > Connection Details > Connection string)
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-your-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Server Port (Render sets this automatically; default 5000 for local dev)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random 32+ character string)
JWT_SECRET=your_super_secret_production_jwt_key_min_32_chars

# Production Frontend URL for CORS (Comma-separated if multiple domains)
FRONTEND_URL=https://grocerykcl.vercel.app

# Cloudinary Media Storage Credentials (From Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Initial Administrator Credentials Sync
ADMIN_EMAIL=joelramireddy@gmail.com
ADMIN_PASSWORD=your_secure_password_here

# ---------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# ---------------------------------------------------------------------

# Backend Render API Base URL
# (e.g. https://grocery-k0jb.onrender.com)
VITE_API_URL=https://grocery-k0jb.onrender.com
