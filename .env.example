# =====================================================================
# BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard)
# =====================================================================

# Neon PostgreSQL Connection String (from Neon Console > Connection Details)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Server Port (Render sets process.env.PORT automatically, default 5000 for local)
PORT=5000

# Environment Mode
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random 32+ character string)
JWT_SECRET=your_super_secret_production_jwt_key_min_32_chars

# Production Frontend URL for CORS (your Vercel production domain, e.g. https://grocerykcl.vercel.app)
# Note: You can provide comma-separated domains if you have custom domains.
FRONTEND_URL=https://grocerykcl.vercel.app

# Cloudinary Credentials (from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# =====================================================================
# FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# =====================================================================

# Backend Render API Base URL (e.g. https://grocery-k0jb.onrender.com)
# Leave empty for local development to use Vite's built-in dev proxy.
VITE_API_URL=https://grocery-k0jb.onrender.com
