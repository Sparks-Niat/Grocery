# Sri Manikanta Sai General Store - Environment Variables Template
# Copy this file to .env and configure your production values. NEVER commit .env to GitHub.

# Backend (Express / Render)
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Administrator Credentials Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here
ADMIN_INITIAL_PASSWORD=your_secure_password_here

# Frontend (Vite / Vercel)
# Optional in Vercel if using vercel.json rewrites, or set to your Render backend URL:
# VITE_API_URL=https://grocery-k0jb.onrender.com
